{
  "schemaVersion": 1,
  "operations": [
    {
      "operation": "loom.status",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "operation": "loom.plan",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal",
          "criteria",
          "tasks"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "acceptanceCriteriaVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId",
                "text"
              ],
              "properties": {
                "criterionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taskId",
                "title"
              ],
              "properties": {
                "taskId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "maxLength": 12000
                },
                "assigneeAgentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "upstreamTaskId",
                "downstreamTaskId"
              ],
              "properties": {
                "upstreamTaskId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "downstreamTaskId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "condition": {
                  "type": "string",
                  "enum": [
                    "task_done",
                    "artifact_accepted"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "operation": "loom.release",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    {
      "operation": "loom.claim",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "leaseSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    },
    {
      "operation": "loom.evidence",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relativePath"
        ],
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contentType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    {
      "operation": "loom.submit",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "evidenceIds"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "previousCandidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    {
      "operation": "loom.inspect",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    {
      "operation": "loom.stage-review",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "candidateId",
          "policyRevision",
          "manifestHash",
          "verdict",
          "reason",
          "criteriaResults"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "policyRevision": {
            "type": "integer",
            "minimum": 1
          },
          "manifestHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "request_changes",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "criteriaResults": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId",
                "satisfied"
              ],
              "properties": {
                "criterionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "satisfied": {
                  "type": "boolean"
                },
                "evidenceIds": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4000
                }
              }
            }
          }
        }
      }
    }
  ]
}
